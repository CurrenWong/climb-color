# Task files (MediaPipe models)
*.task
*.tflite

# EdgeSAM checkpoints (~40MB each, download on demand)
weights/

# YOLO26 segmentation weights (downloaded by ultralytics on first use, ~6.4MB)
yolo26*-seg.pt
yolo26*.pt
*.pt

# DWPose ONNX weights (yolox_l 206MB + dw-ll_ucoco 128MB, download on demand)
yolox*.onnx
dw-ll_ucoco*.onnx

# EdgeSAM repo clone (is a self-contained git repo with its own .git; don't try to nest)
EdgeSAM/

# Image files
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp

# BUT: docs/demo/ contains curated demo images for README, allow them
!docs/
!docs/demo/
!docs/demo/*.jpg
!docs/demo/*.png

# paper figures (generated by paper/make_fig*.py, small)
!paper/
!paper/*.png
!paper/*.jpg

# Video files
*.mp4
*.avi
*.mov
*.mkv
*.flv
*.wmv

# Archive files
*.zip
*.rar
*.7z
*.tar
*.gz

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Environment / secrets
.env
.env.local
*.log
# evidence logs referenced by paper/bootstrap_margin.py & bootstrap_compare.py
!dwpose_exp/_verify_full.log
!dwpose_exp/dense_sampling.log

# Session-local task notes (Coding Mode)
*_TODO.md

# cmd 2>nul 误生成的空文件
$null
# commit message scratch files
_commit_msg*.txt
# regenerable docx export (paper/make_docx.py)
paper/*.docx
